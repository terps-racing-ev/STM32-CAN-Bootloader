 217:Core/Src/bootloader.c **** /**
 218:Core/Src/bootloader.c ****   * @brief  Process received CAN message
 219:Core/Src/bootloader.c ****   * @retval None
 220:Core/Src/bootloader.c ****   */
 221:Core/Src/bootloader.c **** void Bootloader_ProcessCANMessage(void)
 222:Core/Src/bootloader.c **** {
 223:Core/Src/bootloader.c ****     uint8_t command;
 224:Core/Src/bootloader.c ****     uint32_t address;
 225:Core/Src/bootloader.c ****     uint16_t length;
 226:Core/Src/bootloader.c ****     uint8_t result;
 227:Core/Src/bootloader.c **** 
 228:Core/Src/bootloader.c ****     /* Mark that a CAN command has been received - disable auto-jump timeout */
 229:Core/Src/bootloader.c ****     can_command_received = 1;
 230:Core/Src/bootloader.c ****     
 231:Core/Src/bootloader.c ****     /* Turn on LED3 to indicate CAN activity from host */
 232:Core/Src/bootloader.c ****     LED3_ON();
 233:Core/Src/bootloader.c ****     
 234:Core/Src/bootloader.c ****     /* Reset heartbeat timer to prevent heartbeat from being sent immediately after command */
 235:Core/Src/bootloader.c ****     last_heartbeat_time = HAL_GetTick();
 236:Core/Src/bootloader.c **** 
 237:Core/Src/bootloader.c ****     /* Get the command byte */
 238:Core/Src/bootloader.c ****     command = rx_data[0];
 239:Core/Src/bootloader.c **** 
 240:Core/Src/bootloader.c ****     switch (command)
 241:Core/Src/bootloader.c ****     {
 242:Core/Src/bootloader.c ****         case CMD_GET_STATUS:
 243:Core/Src/bootloader.c ****             /* Send status information */
 244:Core/Src/bootloader.c ****             tx_data[0] = RESP_DATA;
 245:Core/Src/bootloader.c ****             tx_data[1] = bootloader_status.state;
 246:Core/Src/bootloader.c ****             tx_data[2] = bootloader_status.last_error;
 247:Core/Src/bootloader.c ****             tx_data[3] = (bootloader_status.bytes_written >> 24) & 0xFF;
 248:Core/Src/bootloader.c ****             tx_data[4] = (bootloader_status.bytes_written >> 16) & 0xFF;
 249:Core/Src/bootloader.c ****             tx_data[5] = (bootloader_status.bytes_written >> 8) & 0xFF;
 250:Core/Src/bootloader.c ****             tx_data[6] = bootloader_status.bytes_written & 0xFF;
 251:Core/Src/bootloader.c ****             Bootloader_SendCANMessage(RESP_DATA, tx_data, 8);
 252:Core/Src/bootloader.c ****             break;
 253:Core/Src/bootloader.c ****             
 254:Core/Src/bootloader.c ****         case CMD_ERASE_FLASH:
 255:Core/Src/bootloader.c ****             /* Erase application flash area */
 256:Core/Src/bootloader.c ****             bootloader_status.state = BL_STATE_ERASING;
 257:Core/Src/bootloader.c ****             
 258:Core/Src/bootloader.c ****             /* Clear the application valid flag first */
ARM GAS  C:\Users\Ali\AppData\Local\Temp\cc3sxNW0.s 			page 6


 259:Core/Src/bootloader.c ****             Bootloader_ClearApplicationValidFlag();
 260:Core/Src/bootloader.c ****             
 261:Core/Src/bootloader.c ****             /* Update LED2 since we cleared the valid flag */
 262:Core/Src/bootloader.c ****             Bootloader_LED_UpdateStatus();
 263:Core/Src/bootloader.c ****             
 264:Core/Src/bootloader.c ****             result = Bootloader_EraseApplicationFlash();
 265:Core/Src/bootloader.c ****             if (result == ERR_NONE)
 266:Core/Src/bootloader.c ****             {
 267:Core/Src/bootloader.c ****                 bootloader_status.bytes_written = 0;
 268:Core/Src/bootloader.c ****                 bootloader_status.current_address = APPLICATION_ADDRESS;
 269:Core/Src/bootloader.c ****                 Bootloader_SendACK();
 270:Core/Src/bootloader.c ****             }
 271:Core/Src/bootloader.c ****             else
 272:Core/Src/bootloader.c ****             {
 273:Core/Src/bootloader.c ****                 Bootloader_SendNACK(result);
 274:Core/Src/bootloader.c ****             }
 275:Core/Src/bootloader.c ****             bootloader_status.state = BL_STATE_IDLE;
 276:Core/Src/bootloader.c ****             break;
 277:Core/Src/bootloader.c ****             
 278:Core/Src/bootloader.c ****         case CMD_SET_ADDRESS:
 279:Core/Src/bootloader.c ****             /* Set the current write address */
 280:Core/Src/bootloader.c ****             address = (rx_data[1] << 24) | (rx_data[2] << 16) |
 281:Core/Src/bootloader.c ****                      (rx_data[3] << 8) | rx_data[4];
 282:Core/Src/bootloader.c **** 
 283:Core/Src/bootloader.c ****             /* Validate address is in application area (not in permanent storage) */
 284:Core/Src/bootloader.c ****             if (address >= APPLICATION_ADDRESS && address <= APPLICATION_END_ADDRESS)
 285:Core/Src/bootloader.c ****             {
 286:Core/Src/bootloader.c ****                 bootloader_status.current_address = address;
 287:Core/Src/bootloader.c ****                 buffer_index = 0;  /* Reset buffer */
 288:Core/Src/bootloader.c ****                 Bootloader_SendACK();
 289:Core/Src/bootloader.c ****             }
 290:Core/Src/bootloader.c ****             else
 291:Core/Src/bootloader.c ****             {
 292:Core/Src/bootloader.c ****                 Bootloader_SendNACK(ERR_INVALID_ADDRESS);
 293:Core/Src/bootloader.c ****             }
 294:Core/Src/bootloader.c ****             break;
 295:Core/Src/bootloader.c ****             
 296:Core/Src/bootloader.c ****         case CMD_WRITE_DATA:
 297:Core/Src/bootloader.c ****             /* Write data to flash at current address */
 298:Core/Src/bootloader.c ****             /* Expected format: [CMD] [0x04] [byte0] [byte1] [byte2] [byte3] ... */
 299:Core/Src/bootloader.c ****             /* Receives 4 bytes per message, buffers two messages (8 bytes) before writing */
 300:Core/Src/bootloader.c ****             bootloader_status.state = BL_STATE_WRITING;
 301:Core/Src/bootloader.c ****             length = rx_data[1];  /* Data length - should always be 4 */
 302:Core/Src/bootloader.c ****             
 303:Core/Src/bootloader.c ****             if (length != 4)
 304:Core/Src/bootloader.c ****             {
 305:Core/Src/bootloader.c ****                 Bootloader_SendNACK(ERR_INVALID_DATA_LENGTH);
 306:Core/Src/bootloader.c ****                 bootloader_status.state = BL_STATE_IDLE;
 307:Core/Src/bootloader.c ****                 buffer_index = 0;  /* Reset buffer on error */
 308:Core/Src/bootloader.c ****                 break;
 309:Core/Src/bootloader.c ****             }
 310:Core/Src/bootloader.c ****             
 311:Core/Src/bootloader.c ****             /* Copy 4 bytes to buffer */
 312:Core/Src/bootloader.c ****             for (uint8_t i = 0; i < 4; i++)
 313:Core/Src/bootloader.c ****             {
 314:Core/Src/bootloader.c ****                 flash_buffer[buffer_index++] = rx_data[2 + i];
 315:Core/Src/bootloader.c ****             }
ARM GAS  C:\Users\Ali\AppData\Local\Temp\cc3sxNW0.s 			page 7


 316:Core/Src/bootloader.c ****             
 317:Core/Src/bootloader.c ****             /* Write to flash when we have 8 bytes (two 4-byte chunks) */
 318:Core/Src/bootloader.c ****             if (buffer_index >= 8)
 319:Core/Src/bootloader.c ****             {
 320:Core/Src/bootloader.c ****                 result = Bootloader_WriteFlash(bootloader_status.current_address, 
 321:Core/Src/bootloader.c ****                                                flash_buffer, 8);
 322:Core/Src/bootloader.c ****                 if (result == ERR_NONE)
 323:Core/Src/bootloader.c ****                 {
 324:Core/Src/bootloader.c ****                     bootloader_status.current_address += 8;
 325:Core/Src/bootloader.c ****                     bootloader_status.bytes_written += 8;
 326:Core/Src/bootloader.c ****                     buffer_index = 0;
 327:Core/Src/bootloader.c ****                     Bootloader_SendACK();
 328:Core/Src/bootloader.c ****                 }
 329:Core/Src/bootloader.c ****                 else
 330:Core/Src/bootloader.c ****                 {
 331:Core/Src/bootloader.c ****                     buffer_index = 0;  /* Reset buffer on write failure */
 332:Core/Src/bootloader.c ****                     Bootloader_SendNACK(result);
 333:Core/Src/bootloader.c ****                 }
 334:Core/Src/bootloader.c ****             }
 335:Core/Src/bootloader.c ****             else
 336:Core/Src/bootloader.c ****             {
 337:Core/Src/bootloader.c ****                 Bootloader_SendACK();  /* Data buffered, waiting for more */
