 448:Core/Src/bootloader.c ****     
 449:Core/Src/bootloader.c ****     /* Erase pages one at a time for better responsiveness */
 450:Core/Src/bootloader.c ****     for (uint32_t page = 0; page < num_pages; page++)
 451:Core/Src/bootloader.c ****     {
