 437:Core/Src/bootloader.c ****     HAL_StatusTypeDef status;
 438:Core/Src/bootloader.c ****     
 439:Core/Src/bootloader.c ****     /* Calculate first and last pages for application */
 440:Core/Src/bootloader.c ****     uint32_t first_page = (APPLICATION_ADDRESS - 0x08000000) / FLASH_PAGE_SIZE;
 441:Core/Src/bootloader.c ****     uint32_t num_pages = APPLICATION_SIZE / FLASH_PAGE_SIZE;
 442:Core/Src/bootloader.c ****     
