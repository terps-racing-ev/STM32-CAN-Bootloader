  89:Core/Src/bootloader.c ****   * @brief  Configure CAN filter to accept bootloader messages
  90:Core/Src/bootloader.c ****   * @retval None
  91:Core/Src/bootloader.c ****   */
  92:Core/Src/bootloader.c **** static void Bootloader_ConfigureCANFilter(void)
  93:Core/Src/bootloader.c **** {
  94:Core/Src/bootloader.c ****     CAN_FilterTypeDef can_filter;
  95:Core/Src/bootloader.c ****     
  96:Core/Src/bootloader.c ****     can_filter.FilterBank = 0;
  97:Core/Src/bootloader.c ****     can_filter.FilterMode = CAN_FILTERMODE_IDMASK;
  98:Core/Src/bootloader.c ****     can_filter.FilterScale = CAN_FILTERSCALE_32BIT;
  99:Core/Src/bootloader.c ****     
 100:Core/Src/bootloader.c ****     /* Accept ALL extended IDs for debugging - we'll check ID in callback */
 101:Core/Src/bootloader.c ****     can_filter.FilterIdHigh = 0x0000;
 102:Core/Src/bootloader.c ****     can_filter.FilterIdLow = 0x0004;   /* IDE bit set (extended ID only) */
 103:Core/Src/bootloader.c ****     can_filter.FilterMaskIdHigh = 0x0000;  /* Don't care about ID bits */
 104:Core/Src/bootloader.c ****     can_filter.FilterMaskIdLow = 0x0004;   /* Only check IDE bit */
 105:Core/Src/bootloader.c ****     can_filter.FilterFIFOAssignment = CAN_RX_FIFO0;
 106:Core/Src/bootloader.c ****     can_filter.FilterActivation = ENABLE;
 107:Core/Src/bootloader.c ****     can_filter.SlaveStartFilterBank = 14;
 108:Core/Src/bootloader.c ****     
 109:Core/Src/bootloader.c ****     if (HAL_CAN_ConfigFilter(hcan_bootloader, &can_filter) != HAL_OK)
 110:Core/Src/bootloader.c ****     {
 111:Core/Src/bootloader.c ****         Error_Handler();
 112:Core/Src/bootloader.c ****     }
 113:Core/Src/bootloader.c **** }
 114:Core/Src/bootloader.c **** 
 115:Core/Src/bootloader.c **** /**
 116:Core/Src/bootloader.c ****   * @brief  Main bootloader loop
 117:Core/Src/bootloader.c ****   * @retval None
 118:Core/Src/bootloader.c ****   */
 119:Core/Src/bootloader.c **** void Bootloader_Main(void)
 120:Core/Src/bootloader.c **** {
 121:Core/Src/bootloader.c ****     uint32_t timeout_start = HAL_GetTick();
 122:Core/Src/bootloader.c ****     uint32_t last_heartbeat = HAL_GetTick();
 123:Core/Src/bootloader.c ****     uint32_t last_led_toggle = HAL_GetTick();
 124:Core/Src/bootloader.c ****     uint8_t timeout_expired = 0;
 125:Core/Src/bootloader.c ****     
 126:Core/Src/bootloader.c ****     /* Initialize the static heartbeat time variable */
 127:Core/Src/bootloader.c ****     last_heartbeat_time = last_heartbeat;
 128:Core/Src/bootloader.c ****     
 129:Core/Src/bootloader.c ****     /* Send ready message */
 130:Core/Src/bootloader.c ****     tx_data[0] = RESP_READY;
 131:Core/Src/bootloader.c ****     tx_data[1] = 0x01;  /* Bootloader version */
 132:Core/Src/bootloader.c ****     tx_data[2] = 0x00;  /* Bootloader subversion */
 133:Core/Src/bootloader.c ****     Bootloader_SendCANMessage(RESP_READY, tx_data, 3);
 134:Core/Src/bootloader.c ****     
 135:Core/Src/bootloader.c ****     /* Main bootloader loop with timeout */
 136:Core/Src/bootloader.c ****     while (1)
 137:Core/Src/bootloader.c ****     {
 138:Core/Src/bootloader.c ****         /* Rapid LED flash to indicate bootloader mode (100ms toggle = 5Hz blink) */
 139:Core/Src/bootloader.c ****         if ((HAL_GetTick() - last_led_toggle) >= 100)
 140:Core/Src/bootloader.c ****         {
 141:Core/Src/bootloader.c ****             HAL_GPIO_TogglePin(LED_PORT, LED_PIN);
 142:Core/Src/bootloader.c ****             last_led_toggle = HAL_GetTick();
 143:Core/Src/bootloader.c ****         }
 144:Core/Src/bootloader.c ****         
ARM GAS  C:\Users\Ali\AppData\Local\Temp\cc3sxNW0.s 			page 4


 145:Core/Src/bootloader.c ****         /* Update local heartbeat from static variable (may be reset by command processing) */
 146:Core/Src/bootloader.c ****         last_heartbeat = last_heartbeat_time;
 147:Core/Src/bootloader.c ****         
 148:Core/Src/bootloader.c ****         /* Send heartbeat message periodically only when idle */
 149:Core/Src/bootloader.c ****         if (bootloader_status.state == BL_STATE_IDLE && 
 150:Core/Src/bootloader.c ****             (HAL_GetTick() - last_heartbeat) >= HEARTBEAT_INTERVAL_MS)
 151:Core/Src/bootloader.c ****         {
 152:Core/Src/bootloader.c ****             /* Send ready/heartbeat message */
 153:Core/Src/bootloader.c ****             tx_data[0] = RESP_READY;
 154:Core/Src/bootloader.c ****             tx_data[1] = 0x01;  /* Bootloader version */
 155:Core/Src/bootloader.c ****             tx_data[2] = 0x00;  /* Bootloader subversion */
 156:Core/Src/bootloader.c ****             Bootloader_SendCANMessage(RESP_READY, tx_data, 3);
 157:Core/Src/bootloader.c ****             last_heartbeat = HAL_GetTick();
 158:Core/Src/bootloader.c ****             last_heartbeat_time = last_heartbeat;  /* Update static variable */
 159:Core/Src/bootloader.c ****         }
 160:Core/Src/bootloader.c ****         
 161:Core/Src/bootloader.c ****         /* Check for timeout to auto-jump to application */
 162:Core/Src/bootloader.c ****         /* Only auto-jump if: timeout expired AND no CAN commands received AND valid app exists */
 163:Core/Src/bootloader.c ****         if (!timeout_expired && !can_command_received &&
 164:Core/Src/bootloader.c ****             (HAL_GetTick() - timeout_start >= BOOTLOADER_TIMEOUT_MS))
 165:Core/Src/bootloader.c ****         {
 166:Core/Src/bootloader.c ****             timeout_expired = 1;
 167:Core/Src/bootloader.c **** 
 168:Core/Src/bootloader.c ****             /* Only jump if we have a valid application flag set */
 169:Core/Src/bootloader.c ****             if (Bootloader_CheckApplicationValidFlag())
 170:Core/Src/bootloader.c ****             {
 171:Core/Src/bootloader.c ****                 /* Send timeout jump message */
 172:Core/Src/bootloader.c ****                 tx_data[0] = RESP_READY;
 173:Core/Src/bootloader.c ****                 tx_data[1] = 0xAA;  /* Special: Timeout auto-jump */
 174:Core/Src/bootloader.c ****                 tx_data[2] = 0x55;
 175:Core/Src/bootloader.c ****                 Bootloader_SendCANMessage(RESP_READY, tx_data, 3);
 176:Core/Src/bootloader.c **** 
 177:Core/Src/bootloader.c ****                 /* Wait for message to send */
 178:Core/Src/bootloader.c ****                 Bootloader_WaitForCANTransmission();
 179:Core/Src/bootloader.c ****                 HAL_Delay(10);
 180:Core/Src/bootloader.c **** 
 181:Core/Src/bootloader.c ****                 /* Blink LEDs 5 times rapidly before jumping */
 182:Core/Src/bootloader.c ****                 Bootloader_LED_BlinkBeforeJump();
 183:Core/Src/bootloader.c **** 
 184:Core/Src/bootloader.c ****                 /* Jump to application */
 185:Core/Src/bootloader.c ****                 Bootloader_JumpToApplication();
 186:Core/Src/bootloader.c ****             }
 187:Core/Src/bootloader.c ****             /* If no valid app, stay in bootloader mode indefinitely */
 188:Core/Src/bootloader.c ****         }
 189:Core/Src/bootloader.c ****         
 190:Core/Src/bootloader.c ****         /* Check if we should jump to application (from CAN command) */
 191:Core/Src/bootloader.c ****         if (jump_to_app_flag)
 192:Core/Src/bootloader.c ****         {
 193:Core/Src/bootloader.c ****             /* Send a pre-jump indicator message (using READY with special code) */
 194:Core/Src/bootloader.c ****             tx_data[0] = RESP_READY;
 195:Core/Src/bootloader.c ****             tx_data[1] = 0xFF;  /* Special: About to jump */
 196:Core/Src/bootloader.c ****             tx_data[2] = 0xFF;
 197:Core/Src/bootloader.c ****             Bootloader_SendCANMessage(RESP_READY, tx_data, 3);
 198:Core/Src/bootloader.c ****             
 199:Core/Src/bootloader.c ****             /* Wait for this message to be sent */
 200:Core/Src/bootloader.c ****             Bootloader_WaitForCANTransmission();
 201:Core/Src/bootloader.c ****             
