  88:Core/Src/bootloader.c **** /**
  89:Core/Src/bootloader.c ****   * @brief  Configure CAN filter to accept bootloader messages
  90:Core/Src/bootloader.c ****   * @retval None
  91:Core/Src/bootloader.c ****   */
  92:Core/Src/bootloader.c **** static void Bootloader_ConfigureCANFilter(void)
  93:Core/Src/bootloader.c **** {
  94:Core/Src/bootloader.c ****     CAN_FilterTypeDef can_filter;
  95:Core/Src/bootloader.c ****     
  96:Core/Src/bootloader.c ****     can_filter.FilterBank = 0;
  97:Core/Src/bootloader.c ****     can_filter.FilterMode = CAN_FILTERMODE_IDMASK;
  98:Core/Src/bootloader.c ****     can_filter.FilterScale = CAN_FILTERSCALE_32BIT;
  99:Core/Src/bootloader.c ****     
 100:Core/Src/bootloader.c ****     /* Accept ONLY the host CAN ID (CAN_HOST_ID) with exact 29-bit match.
 101:Core/Src/bootloader.c ****      * For 32-bit filter scale with extended IDs, the register layout is:
 102:Core/Src/bootloader.c ****      *   Bits [31:3] = 29-bit Extended ID
 103:Core/Src/bootloader.c ****      *   Bit  [2]    = IDE (1 = extended frame)
 104:Core/Src/bootloader.c ****      *   Bit  [1]    = RTR
 105:Core/Src/bootloader.c ****      *   Bit  [0]    = 0
 106:Core/Src/bootloader.c ****      * This prevents other CAN bus traffic from filling the 3-deep hardware FIFO. */
 107:Core/Src/bootloader.c ****     uint32_t filter_id   = (CAN_HOST_ID << 3) | 0x04;        /* IDE bit set */
 108:Core/Src/bootloader.c ****     uint32_t filter_mask = (0x1FFFFFFFUL << 3) | 0x04;       /* Match all 29 ID bits + IDE */
 109:Core/Src/bootloader.c ****     
 110:Core/Src/bootloader.c ****     can_filter.FilterIdHigh   = (filter_id >> 16) & 0xFFFF;
 111:Core/Src/bootloader.c ****     can_filter.FilterIdLow    = filter_id & 0xFFFF;
 112:Core/Src/bootloader.c ****     can_filter.FilterMaskIdHigh = (filter_mask >> 16) & 0xFFFF;
 113:Core/Src/bootloader.c ****     can_filter.FilterMaskIdLow  = filter_mask & 0xFFFF;
 114:Core/Src/bootloader.c ****     can_filter.FilterFIFOAssignment = CAN_RX_FIFO0;
 115:Core/Src/bootloader.c ****     can_filter.FilterActivation = ENABLE;
 116:Core/Src/bootloader.c ****     can_filter.SlaveStartFilterBank = 14;
 117:Core/Src/bootloader.c ****     
 118:Core/Src/bootloader.c ****     if (HAL_CAN_ConfigFilter(hcan_bootloader, &can_filter) != HAL_OK)
 119:Core/Src/bootloader.c ****     {
 120:Core/Src/bootloader.c ****         Error_Handler();
 121:Core/Src/bootloader.c ****     }
 122:Core/Src/bootloader.c **** }
 123:Core/Src/bootloader.c **** 
 124:Core/Src/bootloader.c **** /**
 125:Core/Src/bootloader.c ****   * @brief  Main bootloader loop
 126:Core/Src/bootloader.c ****   * @retval None
 127:Core/Src/bootloader.c ****   */
 128:Core/Src/bootloader.c **** void Bootloader_Main(void)
 129:Core/Src/bootloader.c **** {
 130:Core/Src/bootloader.c ****     uint32_t timeout_start = HAL_GetTick();
 131:Core/Src/bootloader.c ****     uint32_t last_heartbeat = HAL_GetTick();
 132:Core/Src/bootloader.c ****     uint32_t last_led_toggle = HAL_GetTick();
 133:Core/Src/bootloader.c ****     uint8_t timeout_expired = 0;
 134:Core/Src/bootloader.c ****     
 135:Core/Src/bootloader.c ****     /* Initialize the static heartbeat time variable */
 136:Core/Src/bootloader.c ****     last_heartbeat_time = last_heartbeat;
 137:Core/Src/bootloader.c ****     
 138:Core/Src/bootloader.c ****     /* Send ready message */
 139:Core/Src/bootloader.c ****     tx_data[0] = RESP_READY;
 140:Core/Src/bootloader.c ****     tx_data[1] = 0x01;  /* Bootloader version */
 141:Core/Src/bootloader.c ****     tx_data[2] = 0x00;  /* Bootloader subversion */
 142:Core/Src/bootloader.c ****     Bootloader_SendCANMessage(RESP_READY, tx_data, 3);
 143:Core/Src/bootloader.c ****     
 144:Core/Src/bootloader.c ****     /* Main bootloader loop with timeout */
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccdQfK6d.s 			page 4


 145:Core/Src/bootloader.c ****     while (1)
 146:Core/Src/bootloader.c ****     {
 147:Core/Src/bootloader.c ****         /* Rapid LED flash to indicate bootloader mode (100ms toggle = 5Hz blink) */
 148:Core/Src/bootloader.c ****         if ((HAL_GetTick() - last_led_toggle) >= 100)
 149:Core/Src/bootloader.c ****         {
 150:Core/Src/bootloader.c ****             HAL_GPIO_TogglePin(LED_PORT, LED_PIN);
 151:Core/Src/bootloader.c ****             last_led_toggle = HAL_GetTick();
 152:Core/Src/bootloader.c ****         }
 153:Core/Src/bootloader.c ****         
 154:Core/Src/bootloader.c ****         /* Update local heartbeat from static variable (may be reset by command processing) */
 155:Core/Src/bootloader.c ****         last_heartbeat = last_heartbeat_time;
 156:Core/Src/bootloader.c ****         
 157:Core/Src/bootloader.c ****         /* Send heartbeat message periodically only when idle */
 158:Core/Src/bootloader.c ****         if (bootloader_status.state == BL_STATE_IDLE && 
 159:Core/Src/bootloader.c ****             (HAL_GetTick() - last_heartbeat) >= HEARTBEAT_INTERVAL_MS)
 160:Core/Src/bootloader.c ****         {
 161:Core/Src/bootloader.c ****             /* Send ready/heartbeat message */
 162:Core/Src/bootloader.c ****             tx_data[0] = RESP_READY;
 163:Core/Src/bootloader.c ****             tx_data[1] = 0x01;  /* Bootloader version */
 164:Core/Src/bootloader.c ****             tx_data[2] = 0x00;  /* Bootloader subversion */
 165:Core/Src/bootloader.c ****             Bootloader_SendCANMessage(RESP_READY, tx_data, 3);
 166:Core/Src/bootloader.c ****             last_heartbeat = HAL_GetTick();
 167:Core/Src/bootloader.c ****             last_heartbeat_time = last_heartbeat;  /* Update static variable */
 168:Core/Src/bootloader.c ****         }
 169:Core/Src/bootloader.c ****         
 170:Core/Src/bootloader.c ****         /* Check for timeout to auto-jump to application */
 171:Core/Src/bootloader.c ****         /* Only auto-jump if: timeout expired AND no CAN commands received AND valid app exists */
 172:Core/Src/bootloader.c ****         if (!timeout_expired && !can_command_received &&
 173:Core/Src/bootloader.c ****             (HAL_GetTick() - timeout_start >= BOOTLOADER_TIMEOUT_MS))
 174:Core/Src/bootloader.c ****         {
 175:Core/Src/bootloader.c ****             timeout_expired = 1;
 176:Core/Src/bootloader.c **** 
 177:Core/Src/bootloader.c ****             /* Only jump if we have a valid application flag set */
 178:Core/Src/bootloader.c ****             if (Bootloader_CheckApplicationValidFlag())
 179:Core/Src/bootloader.c ****             {
 180:Core/Src/bootloader.c ****                 /* Send timeout jump message */
 181:Core/Src/bootloader.c ****                 tx_data[0] = RESP_READY;
 182:Core/Src/bootloader.c ****                 tx_data[1] = 0xAA;  /* Special: Timeout auto-jump */
 183:Core/Src/bootloader.c ****                 tx_data[2] = 0x55;
 184:Core/Src/bootloader.c ****                 Bootloader_SendCANMessage(RESP_READY, tx_data, 3);
 185:Core/Src/bootloader.c **** 
 186:Core/Src/bootloader.c ****                 /* Wait for message to send */
 187:Core/Src/bootloader.c ****                 Bootloader_WaitForCANTransmission();
 188:Core/Src/bootloader.c ****                 HAL_Delay(10);
 189:Core/Src/bootloader.c **** 
 190:Core/Src/bootloader.c ****                 /* Blink LEDs 5 times rapidly before jumping */
 191:Core/Src/bootloader.c ****                 Bootloader_LED_BlinkBeforeJump();
 192:Core/Src/bootloader.c **** 
 193:Core/Src/bootloader.c ****                 /* Jump to application */
 194:Core/Src/bootloader.c ****                 Bootloader_JumpToApplication();
 195:Core/Src/bootloader.c ****             }
 196:Core/Src/bootloader.c ****             /* If no valid app, stay in bootloader mode indefinitely */
 197:Core/Src/bootloader.c ****         }
 198:Core/Src/bootloader.c ****         
 199:Core/Src/bootloader.c ****         /* Check if we should jump to application (from CAN command) */
 200:Core/Src/bootloader.c ****         if (jump_to_app_flag)
 201:Core/Src/bootloader.c ****         {
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccdQfK6d.s 			page 5


 202:Core/Src/bootloader.c ****             /* Send a pre-jump indicator message (using READY with special code) */
 203:Core/Src/bootloader.c ****             tx_data[0] = RESP_READY;
 204:Core/Src/bootloader.c ****             tx_data[1] = 0xFF;  /* Special: About to jump */
 205:Core/Src/bootloader.c ****             tx_data[2] = 0xFF;
 206:Core/Src/bootloader.c ****             Bootloader_SendCANMessage(RESP_READY, tx_data, 3);
 207:Core/Src/bootloader.c ****             
 208:Core/Src/bootloader.c ****             /* Wait for this message to be sent */
 209:Core/Src/bootloader.c ****             Bootloader_WaitForCANTransmission();
 210:Core/Src/bootloader.c ****             
 211:Core/Src/bootloader.c ****             /* Blink LEDs 5 times rapidly before jumping */
 212:Core/Src/bootloader.c ****             Bootloader_LED_BlinkBeforeJump();
 213:Core/Src/bootloader.c ****             
 214:Core/Src/bootloader.c ****             /* Jump to application (this function should not return) */
 215:Core/Src/bootloader.c ****             Bootloader_JumpToApplication();
 216:Core/Src/bootloader.c ****             
 217:Core/Src/bootloader.c ****             /* If we get here, jump failed - reset the flag */
 218:Core/Src/bootloader.c ****             jump_to_app_flag = 0;
 219:Core/Src/bootloader.c ****         }
 220:Core/Src/bootloader.c ****         
 221:Core/Src/bootloader.c ****         /* Process received CAN messages (deferred from interrupt to avoid
 222:Core/Src/bootloader.c ****          * blocking ISR during slow flash writes on a busy bus) */
 223:Core/Src/bootloader.c ****         if (rx_msg_pending)
 224:Core/Src/bootloader.c ****         {
 225:Core/Src/bootloader.c ****             Bootloader_ProcessCANMessage();
 226:Core/Src/bootloader.c ****             rx_msg_pending = 0;
 227:Core/Src/bootloader.c ****         }
 228:Core/Src/bootloader.c ****     }
 229:Core/Src/bootloader.c **** }
