 202:Core/Src/bootloader.c ****             /* Blink LEDs 5 times rapidly before jumping */
 203:Core/Src/bootloader.c ****             Bootloader_LED_BlinkBeforeJump();
 204:Core/Src/bootloader.c ****             
 205:Core/Src/bootloader.c ****             /* Jump to application (this function should not return) */
 206:Core/Src/bootloader.c ****             Bootloader_JumpToApplication();
 207:Core/Src/bootloader.c ****             
 208:Core/Src/bootloader.c ****             /* If we get here, jump failed - reset the flag */
 209:Core/Src/bootloader.c ****             jump_to_app_flag = 0;
 210:Core/Src/bootloader.c ****         }
 211:Core/Src/bootloader.c ****         
 212:Core/Src/bootloader.c ****         /* Process received CAN messages (handled in interrupt) */
 213:Core/Src/bootloader.c ****         HAL_Delay(1);
 214:Core/Src/bootloader.c ****     }
