 453:Core/Src/bootloader.c ****         erase_init.TypeErase = FLASH_TYPEERASE_PAGES;
 454:Core/Src/bootloader.c ****         erase_init.Banks = FLASH_BANK_1;
 455:Core/Src/bootloader.c ****         erase_init.Page = first_page + page;
 456:Core/Src/bootloader.c ****         erase_init.NbPages = 1;
 457:Core/Src/bootloader.c ****         
 458:Core/Src/bootloader.c ****         /* Perform erase */
 459:Core/Src/bootloader.c ****         status = HAL_FLASHEx_Erase(&erase_init, &page_error);
 460:Core/Src/bootloader.c ****         
 461:Core/Src/bootloader.c ****         if (status != HAL_OK)
 462:Core/Src/bootloader.c ****         {
 463:Core/Src/bootloader.c ****             HAL_FLASH_Lock();
 464:Core/Src/bootloader.c ****             bootloader_status.last_error = ERR_FLASH_ERASE_FAILED;
 465:Core/Src/bootloader.c ****             return ERR_FLASH_ERASE_FAILED;
 466:Core/Src/bootloader.c ****         }
 467:Core/Src/bootloader.c ****     }
 468:Core/Src/bootloader.c ****     
 469:Core/Src/bootloader.c ****     /* Lock flash */
 470:Core/Src/bootloader.c ****     HAL_FLASH_Lock();
 471:Core/Src/bootloader.c ****     
 472:Core/Src/bootloader.c ****     bootloader_status.last_error = ERR_NONE;
 473:Core/Src/bootloader.c ****     return ERR_NONE;
