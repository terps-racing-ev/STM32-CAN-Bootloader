 231:Core/Src/bootloader.c **** /**
 232:Core/Src/bootloader.c ****   * @brief  Process received CAN message
 233:Core/Src/bootloader.c ****   * @retval None
 234:Core/Src/bootloader.c ****   */
 235:Core/Src/bootloader.c **** void Bootloader_ProcessCANMessage(void)
 236:Core/Src/bootloader.c **** {
 237:Core/Src/bootloader.c ****     uint8_t command;
 238:Core/Src/bootloader.c ****     uint32_t address;
 239:Core/Src/bootloader.c ****     uint16_t length;
 240:Core/Src/bootloader.c ****     uint8_t result;
 241:Core/Src/bootloader.c **** 
 242:Core/Src/bootloader.c ****     /* Mark that a CAN command has been received - disable auto-jump timeout */
 243:Core/Src/bootloader.c ****     can_command_received = 1;
 244:Core/Src/bootloader.c ****     
 245:Core/Src/bootloader.c ****     /* Turn on LED3 to indicate CAN activity from host */
 246:Core/Src/bootloader.c ****     LED3_ON();
 247:Core/Src/bootloader.c ****     
 248:Core/Src/bootloader.c ****     /* Reset heartbeat timer to prevent heartbeat from being sent immediately after command */
 249:Core/Src/bootloader.c ****     last_heartbeat_time = HAL_GetTick();
 250:Core/Src/bootloader.c **** 
 251:Core/Src/bootloader.c ****     /* Get the command byte */
 252:Core/Src/bootloader.c ****     command = rx_data[0];
 253:Core/Src/bootloader.c **** 
 254:Core/Src/bootloader.c ****     switch (command)
 255:Core/Src/bootloader.c ****     {
 256:Core/Src/bootloader.c ****         case CMD_GET_STATUS:
 257:Core/Src/bootloader.c ****             /* Send status information */
 258:Core/Src/bootloader.c ****             tx_data[0] = RESP_DATA;
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccdQfK6d.s 			page 6


 259:Core/Src/bootloader.c ****             tx_data[1] = bootloader_status.state;
 260:Core/Src/bootloader.c ****             tx_data[2] = bootloader_status.last_error;
 261:Core/Src/bootloader.c ****             tx_data[3] = (bootloader_status.bytes_written >> 24) & 0xFF;
 262:Core/Src/bootloader.c ****             tx_data[4] = (bootloader_status.bytes_written >> 16) & 0xFF;
 263:Core/Src/bootloader.c ****             tx_data[5] = (bootloader_status.bytes_written >> 8) & 0xFF;
 264:Core/Src/bootloader.c ****             tx_data[6] = bootloader_status.bytes_written & 0xFF;
 265:Core/Src/bootloader.c ****             Bootloader_SendCANMessage(RESP_DATA, tx_data, 8);
 266:Core/Src/bootloader.c ****             break;
 267:Core/Src/bootloader.c ****             
 268:Core/Src/bootloader.c ****         case CMD_ERASE_FLASH:
 269:Core/Src/bootloader.c ****             /* Erase application flash area */
 270:Core/Src/bootloader.c ****             bootloader_status.state = BL_STATE_ERASING;
 271:Core/Src/bootloader.c ****             
 272:Core/Src/bootloader.c ****             /* Clear the application valid flag first */
 273:Core/Src/bootloader.c ****             Bootloader_ClearApplicationValidFlag();
 274:Core/Src/bootloader.c ****             
 275:Core/Src/bootloader.c ****             /* Update LED2 since we cleared the valid flag */
 276:Core/Src/bootloader.c ****             Bootloader_LED_UpdateStatus();
 277:Core/Src/bootloader.c ****             
 278:Core/Src/bootloader.c ****             result = Bootloader_EraseApplicationFlash();
 279:Core/Src/bootloader.c ****             if (result == ERR_NONE)
 280:Core/Src/bootloader.c ****             {
 281:Core/Src/bootloader.c ****                 bootloader_status.bytes_written = 0;
 282:Core/Src/bootloader.c ****                 bootloader_status.current_address = APPLICATION_ADDRESS;
 283:Core/Src/bootloader.c ****                 Bootloader_SendACK();
 284:Core/Src/bootloader.c ****             }
 285:Core/Src/bootloader.c ****             else
 286:Core/Src/bootloader.c ****             {
 287:Core/Src/bootloader.c ****                 Bootloader_SendNACK(result);
 288:Core/Src/bootloader.c ****             }
 289:Core/Src/bootloader.c ****             bootloader_status.state = BL_STATE_IDLE;
 290:Core/Src/bootloader.c ****             break;
 291:Core/Src/bootloader.c ****             
 292:Core/Src/bootloader.c ****         case CMD_SET_ADDRESS:
 293:Core/Src/bootloader.c ****             /* Set the current write address */
 294:Core/Src/bootloader.c ****             address = (rx_data[1] << 24) | (rx_data[2] << 16) |
 295:Core/Src/bootloader.c ****                      (rx_data[3] << 8) | rx_data[4];
 296:Core/Src/bootloader.c **** 
 297:Core/Src/bootloader.c ****             /* Validate address is in application area (not in permanent storage) */
 298:Core/Src/bootloader.c ****             if (address >= APPLICATION_ADDRESS && address <= APPLICATION_END_ADDRESS)
 299:Core/Src/bootloader.c ****             {
 300:Core/Src/bootloader.c ****                 bootloader_status.current_address = address;
 301:Core/Src/bootloader.c ****                 buffer_index = 0;  /* Reset buffer */
 302:Core/Src/bootloader.c ****                 Bootloader_SendACK();
 303:Core/Src/bootloader.c ****             }
 304:Core/Src/bootloader.c ****             else
 305:Core/Src/bootloader.c ****             {
 306:Core/Src/bootloader.c ****                 Bootloader_SendNACK(ERR_INVALID_ADDRESS);
 307:Core/Src/bootloader.c ****             }
 308:Core/Src/bootloader.c ****             break;
 309:Core/Src/bootloader.c ****             
 310:Core/Src/bootloader.c ****         case CMD_WRITE_DATA:
 311:Core/Src/bootloader.c ****             /* Write data to flash at current address */
 312:Core/Src/bootloader.c ****             /* Expected format: [CMD] [0x04] [byte0] [byte1] [byte2] [byte3] ... */
 313:Core/Src/bootloader.c ****             /* Receives 4 bytes per message, buffers two messages (8 bytes) before writing */
 314:Core/Src/bootloader.c ****             bootloader_status.state = BL_STATE_WRITING;
 315:Core/Src/bootloader.c ****             length = rx_data[1];  /* Data length - should always be 4 */
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccdQfK6d.s 			page 7


 316:Core/Src/bootloader.c ****             
 317:Core/Src/bootloader.c ****             if (length != 4)
 318:Core/Src/bootloader.c ****             {
 319:Core/Src/bootloader.c ****                 Bootloader_SendNACK(ERR_INVALID_DATA_LENGTH);
 320:Core/Src/bootloader.c ****                 bootloader_status.state = BL_STATE_IDLE;
 321:Core/Src/bootloader.c ****                 buffer_index = 0;  /* Reset buffer on error */
 322:Core/Src/bootloader.c ****                 break;
 323:Core/Src/bootloader.c ****             }
 324:Core/Src/bootloader.c ****             
 325:Core/Src/bootloader.c ****             /* Copy 4 bytes to buffer */
 326:Core/Src/bootloader.c ****             for (uint8_t i = 0; i < 4; i++)
 327:Core/Src/bootloader.c ****             {
 328:Core/Src/bootloader.c ****                 flash_buffer[buffer_index++] = rx_data[2 + i];
 329:Core/Src/bootloader.c ****             }
 330:Core/Src/bootloader.c ****             
 331:Core/Src/bootloader.c ****             /* Write to flash when we have 8 bytes (two 4-byte chunks) */
