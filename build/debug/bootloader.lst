 583:Core/Src/bootloader.c **** /**
 584:Core/Src/bootloader.c ****   * @brief  Check if valid application exists
 585:Core/Src/bootloader.c ****   * @retval 1 if valid application, 0 otherwise
 586:Core/Src/bootloader.c ****   */
 587:Core/Src/bootloader.c **** uint8_t Bootloader_CheckValidApplication(void)
 588:Core/Src/bootloader.c **** {
 589:Core/Src/bootloader.c ****     uint32_t stack_pointer = *(__IO uint32_t *)APPLICATION_ADDRESS;
 590:Core/Src/bootloader.c ****     uint32_t reset_handler = *(__IO uint32_t *)(APPLICATION_ADDRESS + 4);
 591:Core/Src/bootloader.c ****     
 592:Core/Src/bootloader.c ****     /* Check if stack pointer is in valid RAM range */
 593:Core/Src/bootloader.c ****     if ((stack_pointer & 0xFFF00000) != 0x20000000)
 594:Core/Src/bootloader.c ****     {
 595:Core/Src/bootloader.c ****         return 0;
 596:Core/Src/bootloader.c ****     }
 597:Core/Src/bootloader.c ****     
 598:Core/Src/bootloader.c ****     /* Check if reset handler is in valid flash range (odd address for Thumb) */
 599:Core/Src/bootloader.c ****     if ((reset_handler & 0xFF000000) != 0x08000000 || (reset_handler & 0x01) == 0)
 600:Core/Src/bootloader.c ****     {
 601:Core/Src/bootloader.c ****         return 0;
 602:Core/Src/bootloader.c ****     }
 603:Core/Src/bootloader.c ****     
 604:Core/Src/bootloader.c ****     return 1;
 605:Core/Src/bootloader.c **** }
