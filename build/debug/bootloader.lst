 597:Core/Src/bootloader.c **** /**
 598:Core/Src/bootloader.c ****   * @brief  Check if valid application exists
 599:Core/Src/bootloader.c ****   * @retval 1 if valid application, 0 otherwise
 600:Core/Src/bootloader.c ****   */
 601:Core/Src/bootloader.c **** uint8_t Bootloader_CheckValidApplication(void)
 602:Core/Src/bootloader.c **** {
 603:Core/Src/bootloader.c ****     uint32_t stack_pointer = *(__IO uint32_t *)APPLICATION_ADDRESS;
 604:Core/Src/bootloader.c ****     uint32_t reset_handler = *(__IO uint32_t *)(APPLICATION_ADDRESS + 4);
 605:Core/Src/bootloader.c ****     
 606:Core/Src/bootloader.c ****     /* Check if stack pointer is in valid RAM range */
 607:Core/Src/bootloader.c ****     if ((stack_pointer & 0xFFF00000) != 0x20000000)
 608:Core/Src/bootloader.c ****     {
 609:Core/Src/bootloader.c ****         return 0;
 610:Core/Src/bootloader.c ****     }
 611:Core/Src/bootloader.c ****     
 612:Core/Src/bootloader.c ****     /* Check if reset handler is in valid flash range (odd address for Thumb) */
 613:Core/Src/bootloader.c ****     if ((reset_handler & 0xFF000000) != 0x08000000 || (reset_handler & 0x01) == 0)
 614:Core/Src/bootloader.c ****     {
 615:Core/Src/bootloader.c ****         return 0;
 616:Core/Src/bootloader.c ****     }
 617:Core/Src/bootloader.c ****     
 618:Core/Src/bootloader.c ****     return 1;
 619:Core/Src/bootloader.c **** }
 620:Core/Src/bootloader.c **** 
