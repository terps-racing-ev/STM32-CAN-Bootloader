 433:Core/Src/bootloader.c **** static uint8_t Bootloader_EraseApplicationFlash(void)
 434:Core/Src/bootloader.c **** {
 435:Core/Src/bootloader.c ****     FLASH_EraseInitTypeDef erase_init;
